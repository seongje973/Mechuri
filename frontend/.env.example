# frontend/.env.example → frontend/.env 로 복사해서 값을 채우세요 (Expo는 EXPO_PUBLIC_ 로 시작하는 값만 앱에 넣습니다)

# 서버 주소. 비워 두면 Expo 개발 서버와 같은 PC의 5000번 포트를 씁니다 (같은 와이파이의 실제 폰도 동작).
# Expo 터널(--tunnel)이나 배포 서버를 쓸 때만 채우세요. 예: http://192.168.0.12:5000
EXPO_PUBLIC_API_URL=

EXPO_PUBLIC_KAKAO_CLIENT_ID=your_kakao_rest_api_key
# 비워 두면 위 서버 주소 + /api/auth/kakao/callback. 카카오 개발자 콘솔에 등록한 값과 같아야 합니다.
EXPO_PUBLIC_KAKAO_REDIRECT_URI=
