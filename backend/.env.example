# backend/.env.example → backend/.env 로 복사해서 값을 채우세요
PORT=5000
# 아무 긴 무작위 문자열. 예: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace_with_secure_random_secret

# docker-compose.yml 의 기본값과 같음.
# DATABASE_URL(postgres://user:pw@host:5432/db)이 있으면 아래 DB_* 대신 그것을 씁니다 (배포 환경).
# DATABASE_URL=
# 외부에서 클라우드 DB에 SSL로 붙을 때만 true
# DB_SSL=
# DB_SSL=true 인데 DB가 자체 서명 인증서를 쓸 때만 false (인증서 검증을 끔)
# DB_SSL_REJECT_UNAUTHORIZED=
# 개발 중에는 서버가 켜질 때 sync({ alter: true })로 테이블을 맞춥니다. off면 마이그레이션(npm run db:migrate)만 씁니다.
# 운영(NODE_ENV=production)은 항상 마이그레이션만 씁니다.
# DB_SYNC=
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=mechuri_db
DB_USER=postgres
DB_PASSWORD=mechuri_password

KAKAO_REST_API_KEY=your_kakao_rest_api_key
# 카카오 키 없이 지도 화면을 확인할 때만 true. "[샘플]" 표시된 가짜 식당을 준다 (production에서는 무시됨).
RESTAURANT_MOCK=false
KAKAO_REDIRECT_URI=http://localhost:5000/api/auth/kakao/callback

# 카카오 로그인 후 Expo Go로 돌아갈 때 허용할 개발 서버 호스트 (쉼표 구분).
# 사설망 IP(192.168.x.x 등)와 localhost는 기본 허용. Expo 터널을 쓸 때만 그 호스트를 적으세요. 예: abc-anonymous-8081.exp.direct
EXPO_DEV_HOSTS=
