# backend/.env.example → backend/.env 로 복사해서 값을 채우세요
PORT=5000
# 아무 긴 무작위 문자열. 예: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace_with_secure_random_secret

# docker-compose.yml 의 기본값과 같음
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=mechuri_db
DB_USER=postgres
DB_PASSWORD=mechuri_password

KAKAO_REST_API_KEY=your_kakao_rest_api_key
KAKAO_REDIRECT_URI=http://localhost:5000/api/auth/kakao/callback

# 카카오 로그인 후 Expo Go로 돌아갈 때 허용할 개발 서버 호스트 (쉼표 구분).
# 사설망 IP(192.168.x.x 등)와 localhost는 기본 허용. Expo 터널을 쓸 때만 그 호스트를 적으세요. 예: abc-anonymous-8081.exp.direct
EXPO_DEV_HOSTS=
