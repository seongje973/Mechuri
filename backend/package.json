{
  "name": "backend",
  "version": "1.0.0",
  "description": "MeChuri backend server",
  "main": "src/app.js",
  "scripts": {
    "start": "node src/app.js",
    "start:prod": "sequelize-cli db:migrate && node src/app.js",
    "dev": "nodemon src/app.js",
    "test": "node --test",
    "db:migrate": "sequelize-cli db:migrate",
    "db:migrate:undo": "sequelize-cli db:migrate:undo",
    "db:migrate:status": "sequelize-cli db:migrate:status",
    "db:migration:new": "sequelize-cli migration:generate --name"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "axios": "^1.16.1",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.12.0",
    "pg-hstore": "^2.3.4",
    "sequelize": "^6.37.5",
    "sequelize-cli": "^6.6.5",
    "socket.io": "^4.8.4"
  },
  "devDependencies": {
    "nodemon": "^3.1.9",
    "socket.io-client": "^4.8.4"
  },
  "engines": {
    "node": ">=20"
  }
}
